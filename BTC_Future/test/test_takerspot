def cancel_order_spot(symbol, order_id):
    try:
        client.cancel_order(symbol=symbol, orderId=order_id); return True
    except Exception as e:
        if "Unknown order" in str(e): return True
        print(f"  Cancel Error: {e}"); return False

def close_position_spot(symbol, quantity, reason):
    """Market SELL to close"""
    try:
        acct = client.get_account()
        b_b = next((b for b in acct['balances'] if b['asset'] == BASE_ASSET), None)
        b_free = float(b_b['free']) if b_b else 0
        if b_free < quantity * 0.9: return True
        sell_qty = min(round(quantity, QTY_PRECISION), round(b_free, QTY_PRECISION))
        sell_qty = float(int(sell_qty / QTY_STEP) * QTY_STEP)
        sell_qty = round(sell_qty, QTY_PRECISION)
        if sell_qty > 0:
            client.create_order(
                symbol=symbol, side='SELL', type='MARKET', quantity=sell_qty
            )
        return True
    except Exception as e:
        print(f"  Close Error: {e}"); return False

last_check_active_ts = 0

def check_active_orders(current_price, current_ts):
    """Check TP/SL/Time exit for active orders"""
    global stats, total_pnl_cash, loss_history, HAS_EXISTING_POSITION, last_check_active_ts

    if not active_orders: return
    if current_ts - last_check_active_ts < 3: return
    last_check_active_ts = current_ts

    for order in active_orders[:]:
        is_exit = False; reason = ""
        if current_price >= order['take_profit']:
            is_exit = True; reason = "TP WIN"
        elif current_price <= order['stop_loss']:
            is_exit = True; reason = "STOP LOSS"
        elif current_ts >= order['exit_ts']:
            is_exit = True; reason = "TIME EXIT"

        if not is_exit:
            continue

        if "TP" in reason:
            # Check if TP limit sell actually filled
            if order.get('sell_order_id'):
                try:
                    sell_status = client.get_order(symbol=SYMBOL_TRADE, orderId=order['sell_order_id'])
                    status = sell_status.get('status', '')
                    if status == 'FILLED':
                        pass
                    elif status in ('NEW', 'PARTIALLY_FILLED'):
                        continue  # wait
                    else:
                        close_position_spot(SYMBOL_TRADE, order['quantity'], reason)
                except:
                    continue
            else:
                close_position_spot(SYMBOL_TRADE, order['quantity'], reason)
        else:
            # SL/TIME: cancel TP order, market sell
            if order.get('sell_order_id'):
                cancel_order_spot(SYMBOL_TRADE, order['sell_order_id'])
            close_position_spot(SYMBOL_TRADE, order['quantity'], reason)

        profit = (current_price - order['entry']) * order['quantity']
        total_pnl_cash += profit
        if profit > 0:
            stats['win'] += 1
        elif profit < 0:
            stats['loss'] += 1
            loss_history.append({
                'time': datetime.datetime.now().strftime('%H:%M:%S'),
                'entry': order['entry'], 'exit': current_price,
                'pnl': profit, 'reason': reason
            })
        else:
            stats['breakeven'] += 1

        send_tg_msg(
            f"{'WIN' if profit >= 0 else 'LOSS'} <b>CLOSED (SPOT)</b>\n━━━━━━━━━━━━━━━━\n"
            f"Entry: ${order['entry']:.2f}\nExit: ${current_price:.2f}\n"
            f"PNL: <b>${profit:.4f}</b>\n{reason}\n"
            f"Active: {len(active_orders)-1}/{MAX_POSITIONS}"
        )
        active_orders.remove(order)
        if len(active_orders) == 0:
            HAS_EXISTING_POSITION = False

