# 8. PREDICTION & SLOT MANAGEMENT
# ==========================================
def get_available_slot(current_ts):
    total_open = len(active_orders)
    if total_open >= MAX_POSITIONS: return None
    if total_open == 0: return 0
    if total_open == 1:
        entry_time = active_orders[0].get('entry_ts', current_ts)
        if (current_ts - entry_time) >= SLOT2_COOLDOWN_SECONDS: return 1
    if total_open == 2:
        slot2 = next((o for o in active_orders if o['slot'] == 1), None)
        if slot2 and (current_ts - slot2.get('entry_ts', current_ts)) >= SLOT3_COOLDOWN_SECONDS: return 2
    if total_open == 3:
        slot3 = next((o for o in active_orders if o['slot'] == 2), None)
        if slot3 and (current_ts - slot3.get('entry_ts', current_ts)) >= SLOT4_COOLDOWN_SECONDS: return 3
    return None

def predict_and_trade(current_ts):
    """V3 prediction — Spot Taker (Long only)"""
    global last_trade_time_per_slot, active_orders, HAS_EXISTING_POSITION

    if not IS_RUNNING: return
    if HAS_EXISTING_POSITION and len(active_orders) == 0: return
    if current_ts % 30 == 0:
        if not check_position_before_trade(): return

    available_slot = get_available_slot(current_ts)
    if available_slot is None: return

    if len(buffer) < 30: return

    feat = compute_features(list(buffer))
    if feat is None: return

    feat_df = pd.DataFrame([feat])[FEATURE_COLS]
    prob = model.predict(feat_df)[0]

    last_price = buffer[-1]['close']

    print(f"\rSPOT TAKER | ${last_price:.1f} | AI: {prob*100:.2f}% | "
          f"OB: bid={order_book['best_bid']:.1f} ask={order_book['best_ask']:.1f} "
          f"imb={order_book['book_imbalance']:.3f} | "
          f"Active: {len(active_orders)} Buf: {len(buffer)}", end="")

    if prob >= CONFIDENCE_THRESHOLD:
        try:
            raw_qty = CAPITAL_PER_TRADE / last_price
            qty = float(int(raw_qty / QTY_STEP) * QTY_STEP)
            qty = round(qty, QTY_PRECISION)

            tp = round(last_price * (1 + PROFIT_TARGET_PCT), PRICE_PRECISION)
            sl = round(last_price * (1 - STOP_LOSS_PCT), PRICE_PRECISION)

            print(f"\n  [SPOT TAKER BUY] Slot {available_slot} @ ~${last_price:.2f} | AI: {prob*100:.2f}%")

            # Market BUY (taker)
            order_response = place_market_buy(SYMBOL_TRADE, qty)

            if order_response:
                # Get actual fill price
                fill_price = last_price
                fills = order_response.get('fills', [])
                if fills:
                    total_cost = sum(float(f['price']) * float(f['qty']) for f in fills)
                    total_qty = sum(float(f['qty']) for f in fills)
                    fill_price = total_cost / total_qty if total_qty > 0 else last_price
                filled_qty = float(order_response.get('executedQty', qty))

                # Actual qty we hold (spot: account for possible rounding)
                sell_qty = float(int(filled_qty / QTY_STEP) * QTY_STEP)
                sell_qty = round(sell_qty, QTY_PRECISION)

                # Recalculate TP/SL from fill price
                tp = round(fill_price * (1 + PROFIT_TARGET_PCT), PRICE_PRECISION)
                sl = round(fill_price * (1 - STOP_LOSS_PCT), PRICE_PRECISION)

                # Place TP limit sell
                sell_order = place_limit_sell(SYMBOL_TRADE, sell_qty, tp)
                sell_order_id = sell_order.get('orderId') if sell_order else None

                active_orders.append({
                    'entry': fill_price, 'quantity': sell_qty,
                    'take_profit': tp, 'stop_loss': sl,
                    'exit_ts': current_ts + HOLDING_TIME, 'entry_ts': current_ts,
                    'sell_order_id': sell_order_id,
                    'confidence': prob, 'slot': available_slot
                })
                last_trade_time_per_slot[available_slot] = current_ts

                send_tg_msg(
                    f"<b>SPOT TAKER BUY</b>\n━━━━━━━━━━━━━━━━\n"
                    f"Entry: ${fill_price:.2f}\n"
                    f"TP: ${tp:.2f} (+{PROFIT_TARGET_PCT*100:.3f}%)\n"
                    f"SL: ${sl:.2f}\n"
                    f"AI: {prob*100:.2f}%\n"
                    f"Qty: {sell_qty}\n"
                    f"Slot: {available_slot + 1}/{MAX_POSITIONS}"
                )
        except Exception as e:
            print(f"\n  Trade Error: {e}")

